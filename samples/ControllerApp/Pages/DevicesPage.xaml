<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MatterControllerApp.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MatterControllerApp.Pages"
    xmlns:models="using:MatterControllerApp.Models">

    <Grid MaxWidth="1200" Padding="36,28,36,36" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Your commissioned Matter devices"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button
                x:Name="HeaderAddDeviceButton"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Center"
                Click="OnAddDeviceClicked"
                Visibility="{x:Bind local:DevicesPage.When(ViewModel.HasDevices), Mode=OneWay}"
                AutomationProperties.AutomationId="AddDeviceButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Add device" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:DevicesPage.When(ViewModel.IsLoading), Mode=OneWay}">
            <ProgressRing Width="32" Height="32" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock Text="Loading your devices…" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:DevicesPage.When(ViewModel.IsEmpty), Mode=OneWay}">
            <Viewbox Width="48" Height="48">
                <SymbolIcon Symbol="Home" />
            </Viewbox>
            <TextBlock
                Text="No devices yet"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Add a Matter device to see its state and available controls here."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="EmptyAddDeviceButton"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Click="OnAddDeviceClicked"
                AutomationProperties.AutomationId="EmptyAddDeviceButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="Add device" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:DevicesPage.When(ViewModel.HasError), Mode=OneWay}">
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Error"
                Title="The controller could not be initialized"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <Button
                Content="Try again"
                Command="{x:Bind ViewModel.RetryCommand}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <GridView
            x:Name="DevicesGrid"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnDeviceClicked"
            Visibility="{x:Bind local:DevicesPage.When(ViewModel.HasDevices), Mode=OneWay}"
            AutomationProperties.AutomationId="KnownDevicesGrid">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,16,16" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:KnownDevice">
                    <Border
                        Width="260"
                        Height="150"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind DisplayName}">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Viewbox Width="28" Height="28" HorizontalAlignment="Left">
                                <SymbolIcon Symbol="Home" />
                            </Viewbox>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="3">
                                <TextBlock
                                    Text="{x:Bind DisplayName}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="Matter device"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            IsClosable="True"
            Severity="Informational"
            Title="Devices"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</Page>
